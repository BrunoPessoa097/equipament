{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "moduleNameMapper": {
    "^(\\..*)\\.js$": "$1",
    "^@nestjs/swagger$": "<rootDir>/../src/__mocks__/@nestjs/swagger.ts"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
