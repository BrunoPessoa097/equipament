// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//tabela de usuarios
model User {
  id Int @id @default(autoincrement())

  name     String  @unique
  email    String  @unique
  password String
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // tipos de relacionamentos
  userRoles         UserRoles[]
  storageEquipUsers StorageEquipUser[]
}

//regras de acesso
model Roles {
  id Int @id @default(autoincrement())

  name        String  @unique
  description String
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //tipo de relacionamento
  userRoles UserRoles[]
}

//tabela de integração de usuário e regras
model UserRoles {
  id Int @id @default(autoincrement())

  id_user  Int
  id_roles Int

  //fazendo os relacionamentos
  user  User  @relation(fields: [id_user], references: [id])
  roles Roles @relation(fields: [id_roles], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //mantendo tudo unico
  @@unique([id_user, id_roles])
}

//tabela de equipamento
model Equipament {
  id Int @id @default(autoincrement())

  name        String
  code        String  @unique
  description String
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  storageEquipUsers StorageEquipUser[]
}

// tabela para local de armazenamento
model Storage {
  id Int @id @default(autoincrement())

  name        String  @unique
  description String
  full        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relacionamentos
  storageEquipUsers StorageEquipUser[]
}

model StorageEquipUser {
  id Int @id @default(autoincrement())

  id_user       Int
  id_storage    Int
  id_equipament Int @unique

  user       User       @relation(fields: [id_user], references: [id])
  storage    Storage    @relation(fields: [id_storage], references: [id])
  equipament Equipament @relation(fields: [id_equipament], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
